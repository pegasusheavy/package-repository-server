# Standalone Dockerfile for Package Repository Server
# Build from repository root: docker build -f docker/Dockerfile.standalone -t package-repo .
# Supports: APT (deb), YUM/DNF (rpm), Pacman (Arch), APK (Alpine)
# Architectures: amd64, arm64
# Uses Ferron (Rust) for static file serving

# Build stage for Rust API server and Ferron
FROM rust:1-alpine3.22 AS builder

RUN apk add --no-cache \
    musl-dev \
    openssl-dev \
    openssl-libs-static \
    pkgconf \
    git \
    cmake \
    make \
    gcc \
    g++ \
    perl \
    linux-headers

WORKDIR /build

# Build the API server
COPY server/ ./server/
RUN cd server && cargo build --release

# Install Ferron from GitHub releases (the crates.io "ferron" name is only a
# reserved placeholder, so cargo install does not work; 1.x is the last
# YAML-config release line matching config/ferron.yaml)
ARG TARGETARCH
RUN apk add --no-cache curl unzip && \
    case "${TARGETARCH:-amd64}" in \
      arm64) FERRON_TARGET="aarch64-unknown-linux-musl" ;; \
      *) FERRON_TARGET="x86_64-unknown-linux-musl" ;; \
    esac && \
    curl -fsSL -o /tmp/ferron.zip \
      "https://github.com/ferronweb/ferron/releases/download/1.3.6/ferron-1.3.6-${FERRON_TARGET}.zip" && \
    unzip -o /tmp/ferron.zip ferron -d /tmp/ferron-dist && \
    install -m 0755 /tmp/ferron-dist/ferron /usr/local/cargo/bin/ferron && \
    rm -rf /tmp/ferron.zip /tmp/ferron-dist

# Final image based on Alpine for small size + APK tools
FROM alpine:3.22

LABEL maintainer="Package Repository Server"
LABEL description="Multi-format package repository server (deb, rpm, arch, alpine)"

# Install all required tools for package management
# Note: createrepo_c is only packaged in Alpine's edge/testing repository,
# so it is installed in a second step from that repository explicitly.
RUN apk add --no-cache \
    bash \
    curl \
    gnupg \
    supervisor \
    dpkg \
    rpm \
    pacman \
    apk-tools \
    xz \
    gzip \
    bzip2 \
    zstd \
    tar \
    coreutils \
    findutils \
    openssl \
    ca-certificates \
    && apk add --no-cache \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/testing \
    createrepo_c

# Create directory structure for repositories
RUN mkdir -p \
    /data/packages/deb/pool \
    /data/packages/deb/dists \
    /data/packages/rpm \
    /data/packages/arch \
    /data/packages/alpine \
    /data/gpg \
    /data/config \
    /var/log/package-repo \
    /etc/ferron

# Copy the Rust server binary
COPY --from=builder /build/server/target/release/package-repo-server /usr/local/bin/

# Copy Ferron binary
COPY --from=builder /usr/local/cargo/bin/ferron /usr/local/bin/

# Copy processing scripts
COPY docker/scripts/entrypoint.sh /entrypoint.sh
COPY docker/scripts/process-deb.sh /usr/local/bin/process-deb
COPY docker/scripts/process-rpm.sh /usr/local/bin/process-rpm
COPY docker/scripts/process-arch.sh /usr/local/bin/process-arch
COPY docker/scripts/process-alpine.sh /usr/local/bin/process-alpine

RUN chmod +x /entrypoint.sh \
    /usr/local/bin/process-deb \
    /usr/local/bin/process-rpm \
    /usr/local/bin/process-arch \
    /usr/local/bin/process-alpine \
    /usr/local/bin/package-repo-server \
    /usr/local/bin/ferron

# Copy Ferron configuration
COPY config/ferron.yaml /etc/ferron/ferron.yaml

# Copy supervisord configuration
COPY docker/supervisord.conf /etc/supervisord.conf

# Environment variables
ENV REPO_DATA_DIR=/data/packages \
    REPO_GPG_DIR=/data/gpg \
    REPO_CONFIG_DIR=/data/config \
    REPO_API_PORT=8080 \
    FERRON_PORT=80 \
    GPG_KEY_ID="" \
    API_KEYS="" \
    S3_ENABLED=false \
    S3_ENDPOINT="" \
    S3_BUCKET="" \
    S3_ACCESS_KEY="" \
    S3_SECRET_KEY="" \
    RUST_LOG=info

EXPOSE 80 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

VOLUME ["/data/packages", "/data/gpg", "/data/config"]

ENTRYPOINT ["/entrypoint.sh"]
